# Copy this file to .env and replace the placeholder with your Meta Model API key (from https://dev.meta.ai).
# Never commit .env: it holds your real key. Left as the placeholder, the app runs in mock mode.
MODEL_API_KEY=your-meta-model-api-key

# Optional settings: remove the leading # to use one.
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# MOCK_MODE=1
